# Byte-compiled / cache
__pycache__/
*.py[cod]
*.pyc
*.pyo
*.so

# Virtual environments
.venv
venv/
env/
ENV/

# Packaging / build
build/
dist/
*.egg-info/
.eggs/

# Data & models (never commit — see configs/*.yaml for expected paths)
/data/
/models/
*.ckpt
*.pt
*.pth
*.parquet
*.pcap
*.pcapng

# Exception: ship the final trained checkpoint (PS requires weights in the repo).
# Parent dirs must be re-included before the file itself.
!models/
!models/wm_final/
!models/wm_final/best.ckpt
!models/wm_final/benchmark.json
!models/wm_final/generalization.json
# ablation scratch (retrained per-run checkpoints + temp metrics) — never commit
/models/_ablations/
/models/wm_ablate_*/
/models/wm_smoke_*/
/models/wm_improved/
!/models/wm_repaired/
/models/wm_repaired/*
!/models/wm_repaired/best.ckpt
!/models/wm_repaired/config.json
!/models/wm_repaired/audit.json
!/models/wm_repaired/experiments.json
!/models/wm_repaired/metrics.json

# Notebooks
.ipynb_checkpoints/

# Experiment tracking
/mlruns/
/runs/
/outputs/
/wandb/
# Logs
*.log
/logs/
# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/


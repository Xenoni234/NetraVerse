# Generated reports and prediction outputs; keep source documentation under docs/
/reports/*
!/reports/pipeline_repair_audit.json
!/reports/pipeline_repair_results.md
!/reports/world_model_improvement.md
/results/*
!/results/lr_baseline.json

# Public SIH showcase release: the small checkpoint and its report are tracked.
# Training logs, optimizer state and generated side files remain ignored.
!/models/wm_sih_demo/
/models/wm_sih_demo/*
!/models/wm_sih_demo/best.ckpt
!/models/wm_sih_demo/finetune_report.json

/frontend/node_modules/
/frontend/dist/

# Generated SIH demo datasets (regenerate with scripts/)
/demo/large_labelled/
/demo/mixed_labelled/
/demo/samples/*.csv
!/demo/samples/sample_webattack_192.168.10.8.csv


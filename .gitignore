# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
build/
.pytest_cache/
.ruff_cache/

# Data: raw datasets and generated artifacts are never committed
/data/raw/
/data/processed/
/data/uploads/
!/data/mitre_mapping.yaml

# Demo samples are regenerated from data/raw with `python -m demo.make_samples`
/demo/samples/*.csv
/demo/samples/*.binetflow

# Only the shipped checkpoints/configs (R18) are tracked
/models/*
!/models/world_model.pt
!/models/training_config.yaml
!/models/baseline_logreg.pkl

# Frontend build deps for the 3D bundle (dist/ IS committed so no node is needed at runtime)
/dashboard/components/topology3d/node_modules/

# Local
.env
.env.*
!.env.example
*.log
.DS_Store
Thumbs.db
.idea/
.vscode/
.claude/

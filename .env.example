# Dashboard -> backend
NV_API_URL=http://127.0.0.1:8000
# URL the browser uses to load the offline 3D bundle (set when it differs from NV_API_URL)
# NV_API_PUBLIC_URL=http://192.168.0.203:8000

# Live sensor (backend host)
# NV_LIVE_IFACE=wlp0s20f3
# NV_LIVE_BPF=ip
# NV_LIVE_TICK_S=15
# NV_LIVE_REPLAY_PCAP=demo/fallback_pcap/live_demo.pcap   # rehearse without a network
# NV_ENFORCE=1                          # really apply nftables rules (otherwise dry-run)
# NV_OPERATOR_TOKEN=change-me           # required header for live Accept/Modify
# NV_PROTECTED_IPS=127.0.0.1,192.168.0.1,192.168.0.203   # never blocked
